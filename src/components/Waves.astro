---
// Petite frise de vagues décorative (aucune photo nécessaire)
interface Props {
  color?: string;
}
const { color = 'var(--color-blue)' } = Astro.props;
---
<svg viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true" style={`width:100%;height:40px;display:block;`}>
  <path
    d="M0 30 Q 50 5, 100 30 T 200 30 T 300 30 T 400 30 T 500 30 T 600 30 T 700 30 T 800 30 T 900 30 T 1000 30 T 1100 30 T 1200 30"
    fill="none"
    stroke={color}
    stroke-width="4"
    stroke-linecap="round"
    opacity="0.55"
  ></path>
</svg>
